# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor. Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── PayPal ───────────────────────────────────────────────
# sandbox | live
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_BASIC_ID=
PAYPAL_PLAN_PRO_ID=

# ── Correos (Resend) ─────────────────────────────────────
RESEND_API_KEY=
# Secreto compartido para proteger las rutas internas /api/emails/*
EMAIL_INTERNAL_SECRET=

# ── Edge Function appointment-reminders ──────────────────
# Estas se configuran como secretos en Supabase
# (Project Settings → Edge Functions → Secrets), no en .env.local:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, SITE_URL, CRON_SECRET,
# TWILIO_ACCOUNT_SID, TWILIO_API_KEY_SID, TWILIO_API_KEY_SECRET, TWILIO_PHONE_NUMBER
